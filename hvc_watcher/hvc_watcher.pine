//@version=6
indicator('HVC Watcher', shorttitle = 'HVC Watch', overlay = true, max_lines_count = 200, max_labels_count = 500)

// ═══════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════

// Volume settings
sma_length = input.int(20, title = 'Volume SMA Length', minval = 1, group = 'Volume Settings', tooltip = 'Volume SMA includes the current bar. A length of 1 cannot produce a multiplier above 1. Volume units depend on the symbol and feed.')
hvc_threshold = input.float(3.0, title = 'HVC Multiplier: Daily and Below', minval = 1.0, step = 0.1, group = 'Volume Settings', tooltip = 'Minimum multiple of the current-inclusive volume SMA for HVC on daily and intraday charts. Also applies to multi-day charts such as 2D.')
hvc_threshold_weekly = input.float(2.0, title = 'HVC Multiplier: Weekly', minval = 1.0, step = 0.1, group = 'Volume Settings', tooltip = 'Minimum multiple of the current-inclusive volume SMA for HVC on weekly charts, including multi-week charts such as 2W.')
hvc_threshold_monthly = input.float(2.0, title = 'HVC Multiplier: Monthly and Above', minval = 1.0, step = 0.1, group = 'Volume Settings', tooltip = 'Minimum multiple of the current-inclusive volume SMA for HVC on monthly charts, including quarterly and yearly charts.')

// Each event uses one line. Keep the retention cap within indicator max_lines_count.
show_rays = input.bool(false, title = 'Show Event Rays', group = 'Rays', tooltip = 'Show horizontal rays at each HVC or HVE close. HVE takes priority when both occur, regardless of marker visibility. Hidden rays are still retained and monitored for touch alerts.')
ray_limit = input.int(5, title = 'Maximum Event Rays', minval = 1, maxval = 200, group = 'Rays', tooltip = 'Keep and monitor this many recent events, even when rays are hidden. Older rays are deleted. A new event candle can still alert on a ray it replaces.')
ray_color_hve = input.color(color.green, title = 'HVE Ray Color', group = 'Rays', tooltip = 'Color and opacity for HVE rays only. Does not change HVE markers or touch alerts.', active = show_rays)
ray_color_hvc = input.color(color.orange, title = 'HVC Ray Color', group = 'Rays', tooltip = 'Color and opacity for HVC rays only. Does not change HVC markers or touch alerts.', active = show_rays)

// Marker settings
show_hve_markers = input.bool(false, title = 'Show HVE Markers', group = 'Markers', tooltip = 'Show Highest Volume Ever (HVE) markers. When disabled, bars that are both HVC and HVE will still display as HVC.')
color_hve = input.color(color.green, title = 'HVE Color', group = 'Markers', tooltip = 'Marker color and opacity for a volume record over earlier loaded chart history, not necessarily an all-time record. Does not change HVE rays.', active = show_hve_markers)
color_hvc = input.color(color.orange, title = 'HVC Color', group = 'Markers', tooltip = 'Marker color and opacity for High Volume Close (HVC) - bars where volume exceeds the SMA threshold. Does not change HVC rays.')
shape_style = input.string('circles', title = 'Shape Style', options = ['circles', 'triangleup', 'diamond', 'cross', 'xcross'], group = 'Markers')

// Label settings
show_multiplier_labels = input.bool(false, title = 'Show Volume Multiplier Labels', group = 'Labels', tooltip = 'Display the rounded volume multiplier (e.g., 3.4x) next to HVC bars')
multiplier_label_color = input.color(color.orange, title = 'Multiplier Label Background', group = 'Labels', inline = 'hvc_label_colors', active = show_multiplier_labels)
multiplier_text_color = input.color(color.black, title = 'Multiplier Label Text', group = 'Labels', inline = 'hvc_label_colors', active = show_multiplier_labels)
show_current_multiplier = input.bool(false, title = 'Show Current Bar Multiplier', group = 'Labels', tooltip = 'Live volume divided by the current-inclusive SMA, not projected closing volume. Updates before bar close and shows N/A without a valid baseline.')
current_label_color = input.color(color.new(color.blue, 50), title = 'Current Bar Label Background', group = 'Labels', inline = 'current_label_colors', active = show_current_multiplier)
current_text_color = input.color(color.white, title = 'Current Bar Label Text', group = 'Labels', inline = 'current_label_colors', active = show_current_multiplier)

// ═══════════════════════════════════════════════════════════════
// CALCULATIONS
// ═══════════════════════════════════════════════════════════════

// Pine classifies quarterly and yearly charts as monthly multiples; multi-day charts use the daily setting.
active_hvc_threshold = timeframe.ismonthly ? hvc_threshold_monthly : timeframe.isweekly ? hvc_threshold_weekly : hvc_threshold
volume_sma = ta.sma(volume, sma_length)
volume_multiplier = not na(volume) and not na(volume_sma) and volume_sma > 0 ? volume / volume_sma : na

// Detection flags
var float hve_threshold = 0
hve_threshold := math.max(hve_threshold, nz(volume[1], 0))
is_hve_raw = volume > hve_threshold and volume > 0
is_hvc_raw = not na(volume) and volume > 0 and not na(volume_sma) and volume_sma > 0 and volume >= volume_sma * active_hvc_threshold

// Confirm events at close without gating the running record or live diagnostics.
is_hve = is_hve_raw and barstate.isconfirmed
is_hvc = is_hvc_raw and barstate.isconfirmed

// Determine which markers to show (HVE takes priority over HVC to avoid overlap)
show_hve = show_hve_markers and is_hve
show_hvc = is_hvc and not show_hve

//@function Map a shape style string to its plotshape constant.
getShape(style) =>
    switch style
        'circles' => shape.circle
        'triangleup' => shape.triangleup
        'diamond' => shape.diamond
        'cross' => shape.cross
        'xcross' => shape.xcross
        => shape.circle

//@function Format a multiplier to one decimal place, or show N/A when unavailable.
getMultiplierText(value) =>
    na(value) ? 'N/A' : str.tostring(value, '0.0') + 'x'

selected_shape = getShape(shape_style)

// ═══════════════════════════════════════════════════════════════
// RENDERING
// ═══════════════════════════════════════════════════════════════

plotshape(series = show_hve, location = location.abovebar, style = selected_shape, size = size.tiny, color = color_hve, title = 'HVE (Highest Volume Ever)')
plotshape(series = show_hvc, location = location.abovebar, style = selected_shape, size = size.tiny, color = color_hvc, title = 'HVC (High Volume Close)')

// Allocate on historical execution so realtime rollback does not recreate the live label.
var label current_label = na
if show_current_multiplier and barstate.isfirst
    current_label := label.new(na, na, '', color = current_label_color,
         textcolor = current_text_color, style = label.style_label_upper_left, size = size.normal)
var array<label> multiplier_labels = array.new<label>()

// Reserve one slot for the live label and prune before allocation to avoid GC eviction.
if show_multiplier_labels and is_hvc and volume_sma > 0
    label_limit = show_current_multiplier ? 499 : 500
    if array.size(multiplier_labels) >= label_limit
        label.delete(array.shift(multiplier_labels))
    label_text = getMultiplierText(volume_multiplier)
    multiplier_label = label.new(bar_index, close, label_text,
              color = multiplier_label_color,
              textcolor = multiplier_text_color,
              style = label.style_label_right,
              size = size.normal)
    array.push(multiplier_labels, multiplier_label)

// Check older rays live, before adding this candle's confirmed ray to exclude self-touches.
var array<line> event_rays = array.new<line>()
ray_touched = false
for event_ray in event_rays
    ray_price = line.get_y1(event_ray)
    if bar_index > line.get_x1(event_ray) and low <= ray_price and high >= ray_price
        ray_touched := true
        break

// Hidden rays still store alert levels. Explicit deletion bounds both modes without drawing GC.
if is_hvc or is_hve
    if array.size(event_rays) >= ray_limit
        line.delete(array.shift(event_rays))
    ray_color = show_rays ? (is_hve ? ray_color_hve : ray_color_hvc) : na
    event_ray = line.new(bar_index, close, bar_index + 1, close, extend = extend.right, color = ray_color)
    array.push(event_rays, event_ray)

// Current bar multiplier
if show_current_multiplier and barstate.islast
    label.set_xy(current_label, bar_index, low)
    label.set_text(current_label, getMultiplierText(volume_multiplier))

// ═══════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════

alertcondition(is_hve, title = 'HVE', message = 'HVE (loaded-history volume record) on {{ticker}} [{{interval}}], close={{close}}, volume multiplier={{plot("Volume Multiplier")}}x')
alertcondition(is_hvc, title = 'HVC', message = 'HVC on {{ticker}} [{{interval}}], close={{close}}, volume multiplier={{plot("Volume Multiplier")}}x')
alertcondition(is_hve or is_hvc, title = 'HVE or HVC', message = 'HVE or HVC on {{ticker}} [{{interval}}], close={{close}}, volume multiplier={{plot("Volume Multiplier")}}x')
alertcondition(ray_touched, title = 'Event Ray Touch', message = 'Price touched an earlier HVC/HVE close ray on {{ticker}} [{{interval}}], close={{close}}')

// Display current values in data window
plot(volume, title = 'Volume', color = na, editable = false, display = display.data_window)
plot(volume_sma, title = 'Volume SMA', color = na, editable = false, display = display.data_window)
plot(hve_threshold, title = 'HVE Threshold', color = na, editable = false, display = display.data_window)
plot(volume_multiplier, title = 'Volume Multiplier', color = na, editable = false, display = display.data_window, precision = 1)
plot(volume_sma * active_hvc_threshold, title = 'HVC Comparison Threshold', color = na, editable = false, display = display.data_window)
plot(is_hvc ? 1 : 0, title = 'HVC Signal', color = na, editable = false, display = display.data_window, precision = 0)
plot(is_hve ? 1 : 0, title = 'HVE Signal', color = na, editable = false, display = display.data_window, precision = 0)
